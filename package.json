{
  "name": "widwin",
  "version": "1.2.0",
  "description": "Widgets de escritorio personalizados creados con HTML",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlejandroBast/Widwin.git"
  },
  "author": "AlejandroBast",
  "build": {
    "appId": "com.alejandrobast.widwin",
    "productName": "Widwin",
    "files": [
      "main.js",
      "widget-preload.js",
      "manager-preload.js",
      "templates.js",
      "manager/**/*",
      "build/icon.png",
      "build/tray.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Widwin-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Widwin-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlejandroBast",
        "repo": "Widwin",
        "releaseType": "release"
      }
    ]
  }
}
